# BUGFIX_TODO.md step D1 (C12), leg B: `neumann` x `linear extrapolation` at
# ghost_size = 1.
#
# THIS IS THE LEG NO OFFSET COINCIDENCE CAN EXPLAIN AWAY.  Leg A can be argued
# with -- "the equal-offset classes are exact, so at ghost_size = 1, where all
# corner offsets are equal, nothing is wrong".  Here ghost_size = 1, every
# offset IS 1, and the answer is still wrong, because the defect is not only
# the integer division:
#
#   `sum(pow2(dst - src))` runs over ALL THREE directions while
#   `sum(pow2(delta))` is set only by the `linear_extrapolation` branch, and
#   `neumann` displaces `src[d]` inward too.
#
# So a z-face x-edge point with one extrapolating direction (z) and one neumann
# direction (x) is rescaled by sqrt(a_x^2 + a_z^2) = sqrt(2) = 1.414 instead of
# a_z = 1, and the three-direction corner by sqrt(3) = 1.732 instead of 1.
# `multipatch_case.md` [BB4].
#
# f = 1 + 5z, with NO x and y dependence: `neumann` copies the nearest interior
# value, which is the analytic value only in a direction in which the field is
# constant.  `TestBoundaries_ExtrapolationParamCheck` refuses this rig if
# affine_cx or affine_cy is nonzero, so the "exact before at the x faces" part
# of the expected result is a theorem about the configuration and not a hope.
#
# Expected before the fix: max|error| = 0 on the x and y faces and on the x-y
# edges (no extrapolating direction there at all), 0 on the z faces (one
# extrapolating direction, `sqrt(a_z^2/1)` exact), and NONZERO on the x-z and
# y-z edges and on all eight corners.

ActiveThorns = "
    CarpetX
    IOUtil
    TestBoundaries
"

Cactus::presync_mode = "presync-only"
Cactus::cctk_itlast = 0
# tools/run_split.sh: mpiexec pty-forwards rank 0 stdout, so Cactus wraps every
# WARNING/ERROR token on .out in ANSI escapes even though .out is a file, and an
# anchored grep on it then matches nothing. Off, so the gate can grep either
# stream.
Cactus::highlight_warning_messages = no

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax =  1.0
CarpetX::ymax =  1.0
CarpetX::zmax =  1.0
CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 8

CarpetX::ghost_size = 1

CarpetX::boundary_x       = "neumann"
CarpetX::boundary_y       = "neumann"
CarpetX::boundary_z       = "linear extrapolation"
CarpetX::boundary_upper_x = "neumann"
CarpetX::boundary_upper_y = "neumann"
CarpetX::boundary_upper_z = "linear extrapolation"

CarpetX::refine_grid_layout = no
CarpetX::blocking_factor_x = 1
CarpetX::blocking_factor_y = 1
CarpetX::blocking_factor_z = 1
CarpetX::max_grid_size_x = 64
CarpetX::max_grid_size_y = 64
CarpetX::max_grid_size_z = 64

CarpetX::poison_undefined_values = yes

TestBoundaries::test_extrapolation = yes
TestBoundaries::affine_c0 = 1.0
TestBoundaries::affine_cx = 0.0
TestBoundaries::affine_cy = 0.0
TestBoundaries::affine_cz = 5.0
TestBoundaries::extrapolation_tolerance = 0.0

IO::out_dir = $parfile
CarpetX::out_metadata = no
CarpetX::out_tsv = yes
CarpetX::out_tsv_vars = "
    TestBoundaries::affine
    TestBoundaries::affine_exact
    TestBoundaries::affine_error
"
