ActiveThorns = "
    BoxInBox
    CarpetX
    CarpetXRegrid
    CoordinatesX
    IOUtil
    TestOutput
"

Cactus::cctk_show_schedule = no
Cactus::presync_mode = "mixed-error"

CarpetX::poison_undefined_values = yes

Cactus::cctk_itlast = 0

# CarpetX::max_grid_size_x = 16
# CarpetX::max_grid_size_y = 16
# CarpetX::max_grid_size_z = 16

CarpetX::ncells_x = 32
CarpetX::ncells_y = 32
CarpetX::ncells_z = 32

CarpetX::xmin = -1.0
CarpetX::ymin = -1.0
CarpetX::zmin = -1.0
CarpetX::xmax = +1.0
CarpetX::ymax = +1.0
CarpetX::zmax = +1.0

CarpetX::max_num_levels = 3
CarpetX::regrid_every = 1

BoxInBox::num_regions = 1
BoxInBox::num_levels_1 = 3
BoxInBox::radius_1[1] = 0.5
BoxInBox::radius_1[2] = 0.25

CarpetX::boundary_x = "linear extrapolation"
CarpetX::boundary_y = "linear extrapolation"
CarpetX::boundary_z = "linear extrapolation"
CarpetX::boundary_upper_x = "linear extrapolation"
CarpetX::boundary_upper_y = "linear extrapolation"
CarpetX::boundary_upper_z = "linear extrapolation"

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no

CarpetX::out_tsv_vars = "
    TestOutput::gf
    TestOutput::sc
    TestOutput::a1
    TestOutput::a2
    TestOutput::a3
"

CarpetX::out_conduit_vars = "
    TestOutput::gf
    TestOutput::sc
    TestOutput::a1
    TestOutput::a2
    TestOutput::a3
"
