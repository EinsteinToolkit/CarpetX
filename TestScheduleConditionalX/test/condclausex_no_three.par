# Conditional READS:/WRITES: inside a SCHEDULE block body, under CarpetX.
# cond_a = no, cond_mode = "three"
#
# "presync-only" rather than "mixed-error": only that mode makes
# CCTK_HasAccess enforce the declared set, so a grid function the active
# registration did not declare comes back as a null pointer.
ActiveThorns = "
    AMReX
    MPI
    yaml_cpp
    zlib
    IOUtil
    Loop
    Arith
    CarpetXRegrid
    CarpetX
    TestScheduleConditionalX
"

Cactus::cctk_itlast  = 0
Cactus::presync_mode = "presync-only"

CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 8

CarpetX::boundary_x       = "neumann"
CarpetX::boundary_y       = "neumann"
CarpetX::boundary_z       = "neumann"
CarpetX::boundary_upper_x = "neumann"
CarpetX::boundary_upper_y = "neumann"
CarpetX::boundary_upper_z = "neumann"

TestScheduleConditionalX::cond_a    = no
TestScheduleConditionalX::cond_mode = "three"
TestScheduleConditionalX::out_dir   = $parfile
