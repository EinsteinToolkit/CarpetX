# Interface definition for thorn TestSubcyclingMC2

IMPLEMENTS: TestSubcyclingMC2

USES INCLUDE HEADER: loop_device.hxx
USES INCLUDE HEADER: vect.hxx
USES INCLUDE HEADER: vec.hxx
USES INCLUDE HEADER: mat.hxx

USES INCLUDE HEADER: derivs.hxx



CCTK_REAL state TYPE=gf TAGS='rhs="rhs" old="old" ks="k1 k2 k3 k4" dependents="error"'
{
  u
  rho
} "Scalar wave state vector"

CCTK_REAL old TYPE=gf TAGS='checkpoint="yes" evolve="no" restrict="no"'
{
  u_old
  rho_old
} "Scalar wave old state vector"

CCTK_REAL rhs TYPE=gf TAGS='checkpoint="no"'
{
  u_rhs
  rho_rhs
} "RHS of scalar wave state vector"

CCTK_REAL k1 TYPE=gf TAGS='checkpoint="yes" evolve="no" restrict="no"'
{
    u_k1
    rho_k1
} "The Runge-Kutta k_1 variables"

CCTK_REAL k2 TYPE=gf TAGS='checkpoint="yes" evolve="no" restrict="no"'
{
    u_k2
    rho_k2
} "The Runge-Kutta k_2 variables"

CCTK_REAL k3 TYPE=gf TAGS='checkpoint="yes" evolve="no" restrict="no"'
{
    u_k3
    rho_k3
} "The Runge-Kutta k_3 variables"

CCTK_REAL k4 TYPE=gf TAGS='checkpoint="yes" evolve="no" restrict="no"'
{
    u_k4
    rho_k4
} "The Runge-Kutta k_4 variables"



CCTK_REAL error TYPE=gf TAGS='checkpoint="no"'
{
  u_err
  rho_err
} "Error in scalar wave state vector"



