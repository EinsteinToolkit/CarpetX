# Schedule definitions for thorn TestSubcyclingProlong

STORAGE: snapshot[2] error snapshot_read

SCHEDULE TestSubcyclingProlong_Init AT initial
{
  LANG: C
  WRITES: snapshot(interior) snapshot_read(everywhere)
  SYNC: snapshot
} "Initialize snapshot = w(0,x) on every level; seed snapshot_read for it=0 output"

SCHEDULE TestSubcyclingProlong_ReadCurrent AT evol BEFORE TestSubcyclingProlong_Update
{
  LANG: C
  READS: snapshot(interior)
  WRITES: snapshot_read(everywhere)
} "Read snapshot's current time level before its refill (consumes the seeded tl=0)"

SCHEDULE TestSubcyclingProlong_Update AT evol
{
  LANG: C
  WRITES: snapshot(interior)
  SYNC: snapshot
} "Set snapshot = w(cctk_time,x) each substep and sync (routes through SyncGroupsByDirISubcycling)"

SCHEDULE TestSubcyclingProlong_Error AT analysis
{
  LANG: C
  READS: snapshot(everywhere)
  WRITES: error(everywhere)
} "error = snapshot - w(cctk_time,x) over interior AND ghosts"
