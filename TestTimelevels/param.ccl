# Parameter definitions for thorn TestTimelevels

CCTK_BOOLEAN check_rotation "Check that test_gf's time levels hold the two previous iteration numbers" STEERABLE=never
{
} "yes"

CCTK_INT initial_resize_timelevels "Number of time levels to allocate for the resized groups at WRAGH" STEERABLE=never
{
  1:3 :: "at most the three declared in interface.ccl"
} 3

CCTK_INT final_resize_timelevels "Number of time levels to allocate for the resized groups from resize_iteration onwards" STEERABLE=never
{
  1:3 :: "at most the three declared in interface.ccl"
} 3

CCTK_INT resize_iteration "Iteration at the end of which the resized groups are reallocated to final_resize_timelevels" STEERABLE=never
{
  -1:* :: "-1 never reallocates"
} -1

CCTK_INT regrow_resize_timelevels "Number of time levels to allocate for the resized groups from regrow_iteration onwards" STEERABLE=never
{
  1:3 :: "at most the three declared in interface.ccl"
} 3

CCTK_INT regrow_iteration "Iteration at the end of which the resized groups are reallocated to regrow_resize_timelevels" STEERABLE=never
{
  -1:* :: "-1 never reallocates"
} -1

CCTK_BOOLEAN check_storage_api "Drive the resized groups through the Cactus group storage API, including the grid array and grid scalar groups, and check that every way of asking for their time level counts agrees" STEERABLE=never
{
} "no"
