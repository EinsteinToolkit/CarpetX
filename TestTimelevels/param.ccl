# Parameter definitions for thorn TestTimelevels

CCTK_BOOLEAN check_rotation "Check that test_gf's time levels hold the two previous iteration numbers" STEERABLE=never
{
} "yes"

CCTK_INT initial_resize_timelevels "Number of time levels to allocate for resize_gf at WRAGH" STEERABLE=never
{
  1:3 :: "at most the three declared in interface.ccl"
} 3

CCTK_INT final_resize_timelevels "Number of time levels to allocate for resize_gf from resize_iteration onwards" STEERABLE=never
{
  1:3 :: "at most the three declared in interface.ccl"
} 3

CCTK_INT resize_iteration "Iteration at the end of which resize_gf is reallocated to final_resize_timelevels" STEERABLE=never
{
  -1:* :: "-1 never reallocates"
} -1
