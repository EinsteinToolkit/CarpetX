# Schedule definitions for thorn TestTimelevels

STORAGE: test_gf[3]
STORAGE: resize_gf[3]
STORAGE: swap_gf[3]
STORAGE: cycle_array[3]
STORAGE: cycle_scalar[3]
STORAGE: storage_array[3]
STORAGE: storage_scalar[3]
STORAGE: observed_test
STORAGE: observed_swap
STORAGE: results
STORAGE: array_results

SCHEDULE TestTimelevels_Init AT initial
{
  LANG: C
  WRITES: test_gf(everywhere)
  WRITES: test_gf_p(everywhere)
  WRITES: test_gf_p_p(everywhere)
} "Initialize every time level to zero, so every time level is genuinely valid from the start"

SCHEDULE TestTimelevels_Write AT evol
{
  LANG: C
  WRITES: test_gf(everywhere)
} "Write the current iteration number into every point of time level 0"

if (check_rotation)
{
  SCHEDULE TestTimelevels_Check AT analysis
  {
    LANG: C
    READS: test_gf(everywhere)
    READS: test_gf_p(everywhere)
    READS: test_gf_p_p(everywhere)
    WRITES: observed_test(everywhere)
  } "Check that time levels 1 and 2 hold the two previous iteration numbers, and copy them where the norm output can reach them"
}

SCHEDULE TestTimelevels_SetupStorage AT wragh
{
  LANG: C
  OPTIONS: global
} "Allocate initial_resize_timelevels time levels for resize_gf, before any level exists"

SCHEDULE TestTimelevels_ResizeWrite AT initial
{
  LANG: C
  WRITES: resize_gf(everywhere)
} "Write the current iteration number into every point of resize_gf time level 0"

SCHEDULE TestTimelevels_ResizeWrite AT evol
{
  LANG: C
  WRITES: resize_gf(everywhere)
} "Write the current iteration number into every point of resize_gf time level 0"

SCHEDULE TestTimelevels_Resize AT poststep
{
  LANG: C
  OPTIONS: global
} "Reallocate resize_gf to final_resize_timelevels time levels at resize_iteration"

SCHEDULE TestTimelevels_ResizeCheck AT analysis
{
  LANG: C
  READS: resize_gf(everywhere)
} "Check how many time levels resize_gf has, which of them are reachable through cctkGH->data, and that reallocating left time level 0 alone"

SCHEDULE TestTimelevels_SwapInit AT initial
{
  LANG: C
  WRITES: swap_gf(everywhere)
  WRITES: swap_gf_p(everywhere)
  WRITES: swap_gf_p_p(everywhere)
} "Mark each of swap_gf's time levels with its own slot number"

SCHEDULE TestTimelevels_SwapInit AT evol
{
  LANG: C
  WRITES: swap_gf(everywhere)
  WRITES: swap_gf_p(everywhere)
  WRITES: swap_gf_p_p(everywhere)
} "Mark each of swap_gf's time levels with its own slot number"

SCHEDULE TestTimelevels_Swap AT poststep
{
  LANG: C
  OPTIONS: level
} "Exchange swap_gf's time levels 0 and 2"

SCHEDULE TestTimelevels_SwapCheck AT analysis
{
  LANG: C
  READS: swap_gf(everywhere)
  READS: swap_gf_p(everywhere)
  READS: swap_gf_p_p(everywhere)
  WRITES: observed_swap(everywhere)
} "Check that the exchange moved both the data and the validity flags, and left the marks in every other slot alone, and copy the exchanged time levels where the norm output can reach them"

if (check_storage_api)
{
  SCHEDULE TestTimelevels_ArraySetupStorage AT wragh
  {
    LANG: C
    OPTIONS: global
  } "Allocate initial_resize_timelevels time levels for storage_array and storage_scalar"

  SCHEDULE TestTimelevels_ArrayInit AT initial
  {
    LANG: C
    OPTIONS: global
    WRITES: cycle_array(everywhere) cycle_array_p(everywhere) cycle_array_p_p(everywhere)
    WRITES: cycle_scalar(everywhere) cycle_scalar_p(everywhere) cycle_scalar_p_p(everywhere)
    WRITES: storage_array(everywhere) storage_scalar(everywhere)
  } "Seed every time level of the cycled groups, and time level 0 of the resized groups"

  SCHEDULE TestTimelevels_ArrayWrite AT evol
  {
    LANG: C
    OPTIONS: global
    WRITES: cycle_array(everywhere) cycle_scalar(everywhere)
    WRITES: storage_array(everywhere) storage_scalar(everywhere)
  } "Write the current iteration number into time level 0 of every grid array and grid scalar group"

  SCHEDULE TestTimelevels_ArrayResize AT poststep
  {
    LANG: C
    OPTIONS: global
  } "Reallocate storage_array and storage_scalar to the number of time levels this iteration expects"

  SCHEDULE TestTimelevels_StorageCheck AT analysis
  {
    LANG: C
    OPTIONS: global
  } "Check that every way of asking how many time levels a group has agrees"

  SCHEDULE TestTimelevels_ArrayCheck AT analysis
  {
    LANG: C
    OPTIONS: global
    WRITES: array_results(everywhere)
  } "Check the grid array and grid scalar groups' data and data pointers in global mode, and record what every time level holds"

  SCHEDULE TestTimelevels_ArrayCheckLocal AT analysis
  {
    LANG: C
  } "Check the grid array and grid scalar groups' data and data pointers through a local mode cGH"
}

SCHEDULE TestTimelevels_Record AT analysis AFTER (TestTimelevels_Check TestTimelevels_ResizeCheck TestTimelevels_SwapCheck TestTimelevels_StorageCheck TestTimelevels_ArrayCheck TestTimelevels_ArrayCheckLocal)
{
  LANG: C
  OPTIONS: global
  WRITES: results(everywhere)
} "Record this iteration's time level counts and the number of checks that have failed, so that the output carries them"

SCHEDULE TestTimelevels_Terminate AT terminate
{
  LANG: C
  OPTIONS: meta
} "Set exit code based on test results"
