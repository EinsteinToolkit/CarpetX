# Interface definition for thorn WaveToyX

IMPLEMENTS: WaveToyX

USES INCLUDE HEADER: loop_device.hxx
USES INCLUDE HEADER: vect.hxx



# public: added so another thorn can INHERITS: WaveToyX and reference
# `state` in its own schedule.ccl (needed by CarpetX/Cartoon2DXWaveToyX,
# a ghost-fill thorn wired up separately -- see its schedule.ccl). Group
# visibility with no marker defaults to private, which blocked that even
# with INHERITS: WaveToyX in place; found by an actual build attempt.
# Purely a visibility annotation -- no behavior change for WaveToyX itself.
public:
CCTK_REAL state TYPE=gf TAGS='rhs="rhs" dependents="energy error" tensortypealias="scalar"'
{
  u
  rho
} "Scalar wave state vector"

CCTK_REAL rhs TYPE=gf TAGS='checkpoint="no"'
{
  u_rhs
  rho_rhs
} "RHS of scalar wave state vector"

CCTK_REAL energy TYPE=gf TAGS='checkpoint="no"'
{
  eps
} "Energy density"

CCTK_REAL error TYPE=gf TAGS='checkpoint="no"'
{
  u_err
  rho_err
} "Error in scalar wave state vector"
